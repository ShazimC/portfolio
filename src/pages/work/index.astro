---
import { Image } from 'astro:assets';
import ImageIcon from '@phosphor-icons/core/assets/light/image-light.svg';
import Base from '../../layouts/Base.astro';
import { formatRange, getResume } from '../../lib/resume';

const { experience, projects } = await getResume();
const roles = experience.toSorted((a, b) => b.start.valueOf() - a.start.valueOf());
---

<Base title="Work" subtitle="To grow.">
  <section aria-labelledby="experience">
    <ol class="timeline">
      {
        roles.map((role) => (
          <li class="role">
            <h3 class="role-title">
              {role.title} at <span class="company">{role.company}</span>
            </h3>
            <p class="meta">{formatRange(role.start, role.end)}</p>
            <p class="summary">{role.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="projects">
    <h2 id="projects" class="eyebrow">Projects</h2>
    <ul class="projects">
      {
        projects.map((project) => (
          <li>
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="project pen-none">
              <div class="cover">
                {project.image ? (
                  <Image src={project.image} alt="" widths={[256, 512]} sizes="16rem" />
                ) : (
                  <ImageIcon class="placeholder" aria-hidden="true" />
                )}
              </div>
              <h3 class="project-name">{project.name}</h3>
              <p class="description">{project.description}</p>
              <p class="details">
                <span>{project.kind}</span>
                {project.status && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{project.status}</span>
                  </>
                )}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  section + section {
    margin-top: var(--space-16);
  }

  .eyebrow {
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
  }

  /* Timeline: hollow dots on a continuous rail. */
  .timeline {
    --dot: 0.875rem;
    --rail: color-mix(in oklch, var(--text-muted) 45%, transparent);

    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;

    &::before {
      content: '';
      position: absolute;
      top: var(--space-3);
      bottom: 0;
      left: calc(var(--dot) / 2 - 1px);
      width: 2px;
      background: var(--rail);
    }
  }

  .role {
    position: relative;
    padding-left: calc(var(--dot) + var(--space-6));

    &::before {
      content: '';
      position: absolute;
      top: var(--space-2);
      left: 0;
      box-sizing: border-box;
      width: var(--dot);
      height: var(--dot);
      border: 2px solid var(--rail);
      border-radius: var(--radius-full);
      background: var(--background);
    }
  }

  .role-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    line-height: var(--leading-tight);
  }

  .company {
    color: var(--link);
  }

  .role .meta {
    margin: var(--space-2) 0 0;
  }

  .summary {
    margin: var(--space-3) 0 0;
  }

  /* Projects: horizontally scrolling row of cards (layout and motion after maggieappleton.com's essay cards). */
  .projects {
    display: flex;
    gap: 11px;
    margin: 0 calc(var(--space-3) * -1);
    padding: var(--space-3);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-3);

    li {
      flex: 0 0 16rem;
      scroll-snap-align: start;
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    padding: 22px;
    border: 1px solid color-mix(in oklch, var(--text) 10%, transparent);
    border-radius: 0.4rem;
    background: color-mix(in oklch, var(--surface), var(--text) 3%);
    color: var(--text);
    box-shadow: 0 2px 8px color-mix(in oklch, var(--shadow-color) 30%, transparent);
    transition:
      transform 0.24s cubic-bezier(0.34, 1.36, 0.64, 1),
      box-shadow 0.18s ease;

    &:is(:hover, :focus-visible) {
      transform: scale(1.02);
      box-shadow: 0 4px 16px color-mix(in oklch, var(--shadow-color) 60%, transparent);

      .project-name {
        color: var(--link);
      }
    }

    &:active {
      transform: scale(1);
      transition-duration: 0.12s;
    }
  }

  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    background: color-mix(in oklch, var(--surface), var(--primary) 8%);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .placeholder {
    width: var(--space-12);
    height: var(--space-12);
    color: color-mix(in oklch, var(--primary) 60%, transparent);
  }

  .project-name {
    margin: 11px 0;
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: var(--weight-regular);
    line-height: 1.3;
    transition: color 0.18s ease;
  }

  .description,
  .details {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: var(--weight-regular);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .description {
    margin: 4px 0 0;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 6px 0 0;
    text-transform: capitalize;
  }

  @media (prefers-reduced-motion: reduce) {
    .project {
      transition: none;
    }
  }
</style>
