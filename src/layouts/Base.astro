---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/transitions.css';
import '../styles/pen.css';
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { fadeSlide } from '../lib/transitions';
import avatar from '../assets/photos/IMG_1902.jpg';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Cormorant+Infant:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet"
    />
    <title>Shazim's portfolio</title>
    <ClientRouter />
  </head>
  <body>
    <nav transition:persist transition:name="nav" transition:animate="none">
      <a href="/" class="nav-title pen-none">
        <Image
          src={avatar}
          alt="Shazim Ch."
          densities={[1, 2]}
          loading="eager"
          class="photo"
          position="top"
        />
      </a>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/work/">Work</a></li>
        <li><a href="/thoughts/">Thoughts</a></li>
      </ul>
    </nav>

    <main class="content" transition:animate={fadeSlide}>
      <header>
        <h1 class="title">{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
      </header>
      <div class="container">
        <slot />
      </div>
    </main>
  </body>
</html>

<style>
  nav {
    display: flex;
    flex-direction: column;
    background-color: var(--background);
    padding: 0 var(--space-4);
    margin-right: var(--space-12);
    width: var(--width-nav);

    .nav-title {
      font-size: var(--text-base);
      font-family: var(--font-body);
      font-weight: var(--weight-light);
      font-style: italic;
      margin-top: 0;
      padding: 0 var(--space-3);
      text-decoration: none;
      width: fit-content;
    }

    .photo {
      display: block;
      width: 6rem;
      height: 7rem;
      object-fit: cover;
      border-radius: var(--radius-lg);
      transition: all 150ms ease-in-out;
    }

    .photo:hover {
      transform: scale(1.02);
      box-shadow: 1px 1px 5px var(--shadow-color);
    }

    .photo:active {
      transform: scale(0.98);
      box-shadow: none;
    }

    ul {
      list-style-type: none;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      margin-top: var(--space-14);
      gap: var(--space-2);

      li a {
        display: block;
        width: fit-content;
        padding: var(--space-2) var(--space-3);
        color: inherit;
        --pen-inset: var(--space-2);
        --pen-offset: 0;
        --pen-rest-opacity: 0;
      }
    }
  }
  .content {
    width: 100%;
    max-width: var(--width-content);
    box-sizing: border-box;
    margin-top: var(--space-5);
  }
  .subtitle {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    line-height: var(--leading-tight);
    margin: var(--space-2) 0 0;
  }

  .container {
    margin-top: var(--space-16);
  }
</style>
