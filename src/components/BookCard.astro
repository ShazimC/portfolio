---
import type { CollectionEntry } from 'astro:content';

interface Props {
  book: CollectionEntry<'books'>;
}

const entry = Astro.props.book;
const book = entry.data;
---

<div class="book-card">
  <div class="row book-card-header">
    <h3 class="book-card-title">{book.title}</h3>
    <span class="book-card-rating">{book.rating}/10</span>
  </div>

  <span class="book-card-author">{book.author}</span>
  <p class="book-card-summary">{book.summary}</p>

  <a href={`/books/${entry.id}`} class="button">Read review</a>
</div>

<style>
  .book-card {
    background-color: var(--surface);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-5) auto;
    box-shadow: var(--shadow-hard);
  }

  .book-card-header {
    justify-content: space-between;
  }

  .book-card-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin: 0;
  }

  .book-card-rating {
    font-weight: var(--weight-bold);
    color: var(--text-muted);
  }

  .book-card-author {
    margin-top: 0;
  }

  .book-card-summary {
    font-size: var(--text-base);
  }
</style>
